# --- Required ---------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). The owner sees the admin panel.
OWNER_ID=
# Public HTTPS address of the app (Tailscale Funnel: https://<machine>.<tailnet>.ts.net)
PUBLIC_URL=
# Your birthday, MM-DD. Each year becomes a "round" of the wishlist.
BIRTHDAY=

# --- Optional ---------------------------------------------------------
# IANA time zone used for the birthday countdown and the nightly backup
TIMEZONE=UTC
# Currencies guests can view prices in (two-decimal ISO codes) and the default one
CURRENCIES=RUB,ILS,USD,EUR
DEFAULT_CURRENCY=RUB
# Where the SQLite database, images and backups live (a Docker volume in production)
DATA_DIR=./data
PORT=8080
# Bot username (without @) and the Mini App short name from BotFather, used for share links
BOT_USERNAME=
APP_SHORT_NAME=
# Nightly backup: how many to keep and at which hour (0-23, TIMEZONE)
BACKUP_KEEP=7
BACKUP_HOUR=3
# How long a Telegram session signature stays valid (seconds)
INITDATA_MAX_AGE_SEC=86400
